#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

#
# Start RStudio Server
#

# Purge the module environment to avoid conflicts
hostname

module purge

module avail

# List loaded modules
module list

# Check if we have a GPU
if [ -n "$CUDA_VISIBLE_DEVICES" ]; then
        APPTAINER_GPU_ENABLE="--nv"
else
        APPTAINER_GPU_ENABLE=""
fi

env

# Benchmark info
echo "TIMING - Starting RStudio at: $(date)"

# Define variables required by RStudio
set -x
myUSER="${USER}"
myHOME="${HOME}"
OOD_ROOT="${PWD}"
WORKDIR="${HOME}/scratch/.ood-rstudio"

mkdir -p "${WORKDIR}/tmp"
mkdir -p "${WORKDIR}/var/lib"
mkdir -p "${WORKDIR}/var/run"
myTMP="${WORKDIR}/tmp"
myVARLIB="${WORKDIR}/var/lib"
myVARRUN="${WORKDIR}/var/run"

# Generate secure cookie for RStudio
mkdir -p "${myTMP}/rstudio-server"
python3 -c 'from uuid import uuid4; print(uuid4())' > "${myTMP}/rstudio-server/secure-cookie-key"
chmod 0600 "${myTMP}/rstudio-server/secure-cookie-key"

# Launch the RStudio Server
export RS_LOG_CONF_FILE="${OOD_ROOT}/logging.conf"
apptainer exec \
	${APPTAINER_GPU_ENABLE} \
        --bind /scratch \
        --bind /sw \
        --bind /u \
        --bind /taiga \
        --bind /projects \
        --bind /work \
        --bind /etc/profile.d \
        --bind /etc/cray-pe.d \
        --bind /opt/cray \
        --bind /opt/rh \
        --bind /var/spool/slurmd/conf-cache:/etc/slurm \
        --bind /opt/slurm \
        --bind /var/run/munge \
	--bind /usr/share/lmod \
	--bind /usr/libexec/grepconf.sh \
	--bind /usr/bin/lua \
	--bind /usr/share/lua \
	--bind /usr/lib64/lua \
	--bind /usr/lib64/liblua.so:/usr/local/lib/liblua.so \
	--bind /lib64/liblua-5.4.so:/usr/local/lib/liblua-5.4.so \
	--bind /lib64/libcrypt.so.2:/usr/local/lib/libcrypt.so.2 \
	--bind /lib64/libtcl8.6.so:/usr/local/lib/libtcl8.6.so \
	--bind /usr/share/tcl8.6 \
	--bind /usr/lib64/tcl8.6 \
	--bind /usr/bin/tclsh \
        --bind ${myTMP}:/tmp \
        --bind ${myVARLIB}:/var/lib/rstudio-server \
        --bind ${myVARRUN}:/var/run/rstudio-server \
        /sw/oodimages/rstudio-app.sif rserver \
        --server-daemonize=0 \
        --www-address=0.0.0.0 \
        --www-port=${port} \
        --server-user="${myUSER}" \
        --auth-none=0 \
        --auth-pam-helper-path="${OOD_ROOT}/bin/auth" \
        --auth-encrypt-password=0 \
        --secure-cookie-key-file="${myTMP}/rstudio-server/secure-cookie-key" 2>&1
